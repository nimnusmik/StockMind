# StockMind 환경 변수 템플릿
# 이 파일을 복사하여 .env로 저장하고 값을 채우세요:
#   cp .env.example .env

# API 시크릿 키 (JWT 토큰 서명용)
# 생성 방법: python3 -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your-secret-key-here

# PostgreSQL 자격증명 (docker-compose에서 사용)
POSTGRES_USER=stockmind_user
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=stockmind

# 데이터베이스 설정 (로컬 직접 접속 시, 로컬 포트 5433)
DATABASE_URL=postgresql://stockmind_user:your-db-password-here@localhost:5433/stockmind

# 크롤러 / 마이그레이션 스크립트용 DB 변수
DB_NAME=stockmind
DB_USER=stockmind_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5433

# 외부 API 키
# TwelveData: https://twelvedata.com 에서 발급
TWELVEDATA_API_KEY=your-twelvedata-api-key-here

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# CORS 설정 (쉼표로 구분, 필요 시 주석 해제)
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
# LOG_LEVEL=INFO
