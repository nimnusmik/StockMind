# StockMind API 환경 변수 예제
# 실제 사용 시 .env로 복사하고 값을 변경하세요

# API 시크릿 키 (JWT 토큰 서명용)
API_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# 데이터베이스 설정
DATABASE_URL=postgresql://user:password@localhost:5432/stockmind

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# 모델 및 데이터 경로 (Docker 내부 경로)
MODEL_DIR=/app/api/models
FEATURES_DIR=/app/news/features
METADATA_DIR=/app/news/metadata

# CORS 설정 (쉼표로 구분)
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# 로그 레벨
# LOG_LEVEL=INFO
